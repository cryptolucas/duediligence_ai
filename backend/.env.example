# Claves de modelos cloud (con cualquiera basta). Sin claves, los documentos propios se procesan
# en modo RULES_FALLBACK (parser + reglas PUC + motor determinista) y el caso demo siempre funciona.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Opcional: forzar un modelo con sintaxis LiteLLM (ej. anthropic/claude-sonnet-5-5, gemini/gemini-2.5-pro, openai/gpt-4.1)
LLM_MODEL=

# Modo confidencial: Ollama local. Si no responde, el deal NUNCA se envía a la nube.
OLLAMA_BASE_URL=http://localhost:11434
# Si el modelo no está descargado se usa el primero instalado (ver GET /api/llm/status).
OLLAMA_MODEL=ollama/llama3.1:8b
OLLAMA_NUM_CTX=32768
# Timeout por llamada a Ollama (segundos); un 8B en hardware modesto puede tardar más de 10 min por llamada.
OLLAMA_TIMEOUT_S=1800

LLM_TIMEOUT_S=600
DATABASE_URL=sqlite:///./catalejo.db
STORAGE_DIR=./storage
