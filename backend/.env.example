# ---------------------------------------------------------------------------
# Inteligencia artificial (gratuita, modelos abiertos)
# ---------------------------------------------------------------------------
# Recomendado: Groq (gratis, sin tarjeta, muy rápido, modelos abiertos Llama 3.3 70B / gpt-oss-120b).
# Cree la clave en https://console.groq.com/keys
GROQ_API_KEY=

# Alternativas gratuitas (con cualquiera basta; se usa la primera disponible en este orden):
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Opcional: forzar el modelo con el prefijo del proveedor. Por defecto: groq/llama-3.3-70b-versatile
# Ejemplos: groq/openai/gpt-oss-120b · openrouter/meta-llama/llama-3.3-70b-instruct:free · gemini/gemini-2.5-flash
LLM_MODEL=
# Modelos de respaldo (separados por coma) si el principal agota su cuota. Por defecto con Groq: groq/openai/gpt-oss-120b
# LLM_FALLBACK_MODELS=
# Tokens de entrada por llamada (el contexto se trocea por debajo de este valor). Por defecto 6000 en Groq.
# LLM_MAX_INPUT_TOKENS=
LLM_MAX_OUTPUT_TOKENS=3000
LLM_TIMEOUT_S=180

# Servidor propio compatible con OpenAI (vLLM, LM Studio, Ollama /v1...). Con esto, LLM_MODEL va sin prefijo.
# LLM_BASE_URL=http://mi-servidor:8000/v1
# LLM_API_KEY=

# ---------------------------------------------------------------------------
# Modo confidencial: Ollama local. Si no responde, el deal NUNCA se envía a la nube.
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Si el modelo no está descargado se usa el primero instalado (ver GET /api/llm/status).
OLLAMA_MODEL=ollama/llama3.1:8b
OLLAMA_NUM_CTX=32768
# Timeout por llamada a Ollama (segundos); un 8B en hardware modesto puede tardar más de 10 min por llamada.
OLLAMA_TIMEOUT_S=1800

# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
# Local: SQLite. En la nube use PostgreSQL (ej. Neon, gratis): pegue la cadena postgresql://... tal cual.
DATABASE_URL=sqlite:///./catalejo.db
STORAGE_DIR=./storage
# Orígenes del frontend autorizados (separados por coma), ej. https://catalejo.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Opcional: expresión regular de orígenes (ej. vistas previas de Vercel): https://catalejo-.*\.vercel\.app
# CORS_ORIGIN_REGEX=
# Opcional: código que deben escribir los usuarios de prueba para entrar (protege datos y cuota de IA).
# ACCESS_CODE=
# Análisis simultáneos; el resto espera en cola.
MAX_CONCURRENT_JOBS=2
